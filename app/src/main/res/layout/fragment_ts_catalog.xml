<?xml version="1.0" encoding="utf-8"?>
<!-- TS.KG Каталог tab: the site's catalogue menus as buttons above the poster grid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingTop="4dp"
        android:paddingEnd="48dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/filter_order"
            style="@style/FilterButton"
            android:background="@drawable/filter_button_bg_ts" />

        <TextView
            android:id="@+id/filter_category"
            style="@style/FilterButton"
            android:background="@drawable/filter_button_bg_ts" />

        <TextView
            android:id="@+id/filter_genre"
            style="@style/FilterButton"
            android:background="@drawable/filter_button_bg_ts" />

        <TextView
            android:id="@+id/filter_country"
            style="@style/FilterButton"
            android:background="@drawable/filter_button_bg_ts" />

        <TextView
            android:id="@+id/filter_year"
            style="@style/FilterButton"
            android:background="@drawable/filter_button_bg_ts" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/catalog_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
