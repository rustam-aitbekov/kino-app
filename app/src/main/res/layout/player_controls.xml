<?xml version="1.0" encoding="utf-8"?>
<!--
  TV-friendly controller: title on top, big play/pause + seek buttons, time bar at the bottom.
  Uses media3's standard view ids so PlayerControlView wires everything up.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- top gradient + title -->
    <TextView
        android:id="@+id/player_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_top_gradient"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="48dp"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_bottom_gradient"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="56dp"
        android:paddingEnd="48dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="80dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:focusable="true"
                app:bar_height="5dp"
                app:buffered_color="#66FFFFFF"
                app:played_color="@color/brand"
                app:scrubber_color="@color/brand"
                app:scrubber_enabled_size="18dp"
                app:unplayed_color="#33FFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="80dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@id/exo_rew"
                style="@style/PlayerButton"
                android:contentDescription="-10s"
                android:src="@drawable/ic_replay" />

            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/PlayerButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Play/Pause" />

            <ImageButton
                android:id="@id/exo_ffwd"
                style="@style/PlayerButton"
                android:contentDescription="+10s"
                android:src="@drawable/ic_forward" />

            <!-- Series only (TS.KG); hidden for films -->
            <TextView
                android:id="@+id/player_next"
                style="@style/PlayerTextButton"
                android:text="@string/player_next"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_subs"
                style="@style/PlayerTextButton"
                android:text="@string/player_subs_off"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
