<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for plain activities (picker) -->
    <style name="Theme.Kino" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="Theme.Kino.Browse" parent="@style/Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="defaultBrandColor">@color/brand</item>
        <item name="defaultSearchColor">@color/brand</item>
    </style>

    <style name="Theme.Kino.Details" parent="@style/Theme.Leanback.Details">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="Theme.Kino.Search" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>

    <style name="Theme.Kino.Player" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
